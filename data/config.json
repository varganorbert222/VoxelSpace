{
  "settings": {
    "renderDistance": {
      "min": 100.0,
      "max": 8000.0,
      "step": 100.0
    },
    "renderScale": {
      "min": 0.1,
      "max": 1.0,
      "step": 0.1
    },
    "fov": {
      "min": 10,
      "max": 90,
      "step": 5
    },
    "quality": {
      "min": 0.55,
      "max": 4,
      "step": 0.05,
      "default": 1
    },
    "mipCount": {
      "min": 1,
      "step": 1,
      "default": 5
    },
    "lodBias": {
      "min": -2,
      "max": 3,
      "step": 0.25,
      "default": 0
    },
    "cloudLodBias": {
      "min": -2,
      "max": 3,
      "step": 0.25,
      "default": 0
    },
    "lodSpacing": {
      "min": 10,
      "max": 800,
      "step": 10,
      "default": 100
    },
    "cameraModes": {
      "values": ["fly", "orbital", "walking"],
      "default": "fly"
    },
    "renderAlgorithms": {
      "values": ["classic", "frustum-space", "voxel"],
      "default": "classic"
    },
    "renderBackends": {
      "values": ["js", "wasm", "webgpu"],
      "default": "js"
    },
    "debugViews": {
      "values": ["color", "height", "depth", "iterations"],
      "default": "color"
    },
    "hudChrome": {
      "default": true
    },
    "radar": {
      "default": true
    },
    "multithread": {
      "default": true
    },
    "showDetails": {
      "default": true
    },
    "showSky": {
      "default": true
    },
    "showClouds": {
      "default": true
    },
    "voxPalFog": {
      "default": true
    },
    "filterDistance": {
      "min": 10,
      "max": 1000,
      "step": 10,
      "default": 500
    }
  },
  "camera": {
    "nearClip": 0.001,
    "farClip": 2000.0,
    "quality": 1.0,
    "renderScale": 0.5,
    "fov": 90.0
  }
}
